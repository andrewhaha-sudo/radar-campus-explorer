{
  "name": "campus-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/platform.mjs dev",
    "build": "node scripts/platform.mjs build",
    "start": "node scripts/platform.mjs preview",
    "preview": "node scripts/platform.mjs preview",
    "lint": "oxlint src scripts tests",
    "test": "node --test tests/*.test.mjs && npm run test:pathfinder",
    "test:e2e": "npm run test:e2e:pathfinder",
    "source:bundle": "node scripts/package-source.mjs",
    "build:campus": "node scripts/platform.mjs build-campus",
    "dev:campus": "vite --host 0.0.0.0 --port 5174",
    "setup:local": "node scripts/platform.mjs setup",
    "check:pathfinder": "node scripts/platform.mjs check",
    "test:pathfinder": "node scripts/platform.mjs unit",
    "test:e2e:campus": "playwright test",
    "test:e2e:pathfinder": "npm --prefix apps/pathfinder run test:e2e",
    "postinstall": "npm --prefix apps/pathfinder ci --no-audit --no-fund && npm --prefix apps/indoor-map ci --no-audit --no-fund",
    "deploy": "node scripts/platform.mjs deploy",
    "build:indoor": "npm --prefix apps/indoor-map run build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "24.x"
  }
}
